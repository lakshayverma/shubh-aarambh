{
  "docs-synchronizer": {
    "enabled": true,
    "PostToolUse": [
      {
        "matcher": "write_to_file|replace_file_content",
        "hooks": [
          {
            "type": "command",
            "command": "node ../scripts/agent-post-tool-hook.cjs",
            "timeout": 15
          }
        ]
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "node ../scripts/agent-stop-hook.cjs",
        "timeout": 15
      }
    ]
  }
}
